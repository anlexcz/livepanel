# Back-end defaults to loopback; Nginx and TLS are NOT deployed by this repository.
LIVEPANEL_HOST=127.0.0.1
LIVEPANEL_PORT=3100
LIVEPANEL_DB_PATH=./data/livepanel.sqlite
LIVEPANEL_LOG_LEVEL=info
LIVEPANEL_DEV_WS=false
# When set, enables authenticated HTTP + /ws/operator.
# Must be the exact browser HTTPS origin, e.g. https://panel.metrobus.cz
# LIVEPANEL_PUBLIC_ORIGIN=https://panel.metrobus.cz
